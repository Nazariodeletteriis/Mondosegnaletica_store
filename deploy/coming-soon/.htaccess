# Mondo Segnaletica — pagina "coming soon"
# I blocchi <IfModule> evitano un errore 500 se un modulo non è attivo sul server.

AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  # L'HTML non va mai messo in cache: quando la pagina cambia
  # (o diventa WordPress) i visitatori devono vedere subito la nuova.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Immagini, favicon e font hanno nomi stabili e cambiano di rado:
  # un anno di cache, così non vengono riscaricati a ogni visita.
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # CSS e JS restano su un'ora, non un anno: cookie.js contiene l'informativa
  # sul consenso, e una modifica deve raggiungere subito anche chi è già stato
  # sul sito. Un anno di cache la congelerebbe sui visitatori di ritorno.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# Pagina di errore: chi sbaglia indirizzo finisce sulla coming soon
# invece di vedere il 404 grezzo di Apache.
ErrorDocument 404 /index.html
